# dev 用の環境変数テンプレート。
#   cp docker/.env.example docker/.env
# して値を埋める。docker/.env は .gitignore 済み（コミットされない）。無くても dev は起動する。

# --- 逆ジオコーディング（中心住所の取得。backend/サーバ側） ---
# Google Geocoding API を使用。未設定だと中心住所は取得できず「取得できません」表示になる
# （アプリの起動・スポット検索は動く）。サーバ側キーでブラウザには露出しない。
# GCP: 「Geocoding API」を有効化。可能なら IP 制限。地図用のブラウザキーとは別キー推奨。
GEOCODING_API_KEY=

# --- 地図表示（Google Maps JavaScript API。frontend/ブラウザ側） ---
# NEXT_PUBLIC_ なのでクライアントに露出する → 必ず GCP で「HTTPリファラ制限」をかけること
# （例: http://localhost/* と本番ドメイン）。上の Geocoding とは別キーにするのが安全。
# GCP: 「Maps JavaScript API」を有効化。未設定だと地図は表示されず案内メッセージになる。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AdvancedMarker 用の Map ID。未設定なら DEMO_MAP_ID を使う。
# 独自スタイルの地図を使うなら Cloud で作成した Map ID を入れる。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- 任意 ---
# 逆ジオコーディングの日次クォータ上限（prod compose が参照）。未設定なら無制限。
# GEOCODE_DAILY_QUOTA=
